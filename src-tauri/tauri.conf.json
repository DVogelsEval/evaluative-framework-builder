{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Evaluative Framework Builder",
  "version": "0.0.1",
  "identifier": "io.github.dvogelseval.evalframework",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Evaluative Framework Builder",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Plan an explicit evaluative framework, locally.",
    "longDescription": "A local-first tool that walks an evaluator through building an explicit evaluative framework — rubrics, evidence and synthesis. Planning only; no evaluation results are recorded and no AI inference runs in the app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
